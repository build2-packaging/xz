# Uncomment to suppress warnings coming from external libraries.
#
#c.internal.scope = current

using c

# Upstream provides 32-bit x86 assembly implementations of the CRCs.
#
using c.as-cpp

# Windows resource file rule (see w32res.build for details).
#
if ($c.target.class == 'windows')
  source $src_root/build/w32res.build

h{*}: extension = h
c{*}: extension = c

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $c.target

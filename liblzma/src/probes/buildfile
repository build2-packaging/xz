# Configuration probes.
#
# Upstream discovers what the compiler and the C library provide by
# compiling test programs (see CMakeLists.txt and cmake/tuklib_*.cmake). We
# do the same, translating each upstream check into a probe that is compiled
# during load together with a control variant (see the "How do I implement
# autoconf-style configuration probing?" build2 HOWTO for background). The
# results are made available as have_* variables in this scope and are
# substituted into config.h by the parent buildfile.
#
# The probe rules are in build/probe.build since the command line tools
# use them as well.
#

source $src_root/build/probe.build

# Headers.
#
# The header name is derived from the target name (for example, byteswap.h
# for have-byteswap-h) and so we specify the ones in subdirectories
# explicitly.
#
buildfile{have-sys-param-h}:     header_name = sys/param.h
buildfile{have-sys-endian-h}:    header_name = sys/endian.h
buildfile{have-sys-byteorder-h}: header_name = sys/byteorder.h

probes =

for h: byteswap sys-param sys-endian sys-byteorder
{
  buildfile{have-$h-h}:
  probes += buildfile{have-$h-h}
}

# C probes.
#
# Upstream performs some checks only if another one succeeds (for example,
# it only checks for _mm_movemask_epi8() if immintrin.h is available). The
# probes are compiled unconditionally instead and the parent buildfile
# combines the results. Note that each probe only includes the headers
# specific to its feature in the probe (as opposed to control) variant
# since the header's absence means the feature is absent.
#
# @@ We would rather use the short-circuiting of the probe rule (make one
#    probe a prerequisite of another) but this makes build2 0.18.1 abort in
#    perform_execute() if this project is imported from a buildfile that is
#    loaded as a directory prerequisite.
#
for p: cpuid                      \
       immintrin                  \
       clock-gettime              \
       clock-monotonic            \
       pthread-condattr-setclock  \
       builtin-bswapxx            \
       bswap-16                   \
       bswap-32                   \
       bswap-64                   \
       builtin-assume-aligned     \
       cpucores-sched-getaffinity \
       cpucores-cpuset            \
       cpucores-sysctl            \
       cpucores-sysconf           \
       cpucores-pstat-getdynamic  \
       physmem-aix                \
       physmem-sysconf            \
       physmem-sysctl             \
       physmem-pstat-getstatic    \
       func-attribute-constructor \
       mm-movemask-epi8           \
       usable-clmul               \
       arm64-crc32                \
       getauxval                  \
       hwcap-crc32                \
       elf-aux-info               \
       sysctlbyname               \
       loongarch-crc32
{
  buildfile{have-$p}: c{have-$p}
  probes += buildfile{have-$p}
}

# Compilers that don't support an attribute may only warn about it.
#
if ($c.class == 'gcc')
  buildfile{have-func-attribute-constructor}: c.coptions += -Werror

./: $probes # Make sure gets cleaned.

# We only need the results to generate config.h and so we limit probing to
# the perform meta-operation (for example, to avoid surprising compilations
# during configure). Elsewhere the results stay undefined since config.h is
# not generated.
#
if ($build.meta_operation == 'perform')
{
  update $probes
  source $path($probes)
}

# The xzdec part of upstream's test_files.sh (see tests/tests.cmake). We
# cannot run the script itself since it requires xz (which is in a separate
# package) and so we have ported the corresponding checks. Note that this
# also makes them work on Windows.
#
# Note that a test dependency on the xz package is of no use here since
# installing xzdec doesn't install the xz executable. So when testing the
# installed xzdec, the import would find whatever xz is in PATH, which may
# well be a different version.
#
# Note also that upstream runs this test only if all the decoders and
# integrity checks are enabled, which is always the case for the liblzma
# package.
#
import xzdec = xzdec%exe{xzdec}

./: testscript $xzdec files/file{*}

testscript{*}: test = $xzdec

# Upstream's command line tool tests (see tests/tests.cmake). Out of these
# only test_files.sh exercises xzdec, which it does together with xz. This
# is a POSIX shell script that upstream only runs on POSIX systems, which we
# do as well. It takes the directories of xz and xzdec as its arguments and
# reads its input files relative to the srcdir environment variable.
#
# Note that upstream runs this test only if all the decoders and integrity
# checks are enabled, which is always the case for the liblzma package.
#
posix = ($c.target.class != 'windows')

if $posix
{
  import xz    = xz%exe{xz}
  import xzdec = xzdec%exe{xzdec}

  testscript{*}:
  {
    test = $xzdec

    xz = $xz
  }
}

./: testscript $xz $xzdec: include = $posix
./: file{test_files.sh} files/file{*}

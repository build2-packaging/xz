# The test script expects xz and xzdec in the directories passed as its
# arguments and so we set one up with symlinks to the executables being
# tested.
#
+mkdir bin
+ln -s $path($xz) bin/
+ln -s $0 bin/

bin = $~/bin

: decompress-files
:
: Test decompression of the good, bad, and unsupported test files.
:
env "srcdir=$src_base" -- sh $src_base/test_files.sh $bin $bin 1>&2
